# Database
DATABASE_URL=postgresql+asyncpg://watchlog:watchlog@localhost:5432/watchlog

# Redis
REDIS_URL=redis://localhost:6379

# API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXTENSION_API_KEY=your_extension_api_key_here

# TVMaze
TVMAZE_BASE_URL=https://api.tvmaze.com
TVMAZE_CACHE_TTL=21600
BM25_CACHE_TTL=3600

# Scheduler
SEASON_CHECK_MONTHS=6

# RAG / Embeddings
CHROMA_PERSIST_DIR=./chroma_db
BM25_INDEX_DIR=./bm25_indexes
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Rate Limiting
AGENT_RATE_LIMIT=20/minute

# Logging
LOG_LEVEL=INFO
DEBUG=False
